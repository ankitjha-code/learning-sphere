# LearnSphere Nexus configuration. Copy to .env and fill in only what you use.
# Every value is optional in development: the app runs with an embedded database,
# no email and no AI provider, and labels each unavailable capability honestly.

# ---------- Server ----------
# NODE_ENV=development
# PORT=4317
# Public URL users open (used in emails, invite links and CSRF origin checks)
# APP_URL=http://localhost:5317
# REQUIRED in production: any long random string (encrypts stored provider keys)
# APP_SECRET=change-me-to-a-long-random-string
# Set when behind a reverse proxy/load balancer so client IPs are read from X-Forwarded-For
# TRUST_PROXY=false
# Demo accounts and sample organizations (default: on in development, off in production)
# SEED_DEMO=true

# ---------- Database ----------
# Leave unset to use embedded PGlite at ./data/pglite (zero setup).
# Free hosted options (see docs/FREE_SERVICES.md): Neon, Azure PostgreSQL Flexible (Azure for Students), Supabase, Aiven
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# PGLITE_DIR=./data/pglite

# ---------- AI providers (all optional, all free tiers; first enabled one wins, others are failover) ----------
# Google AI Studio key (no card): https://aistudio.google.com/apikey  Note: free-tier prompts may be used for training.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Groq (no card): https://console.groq.com/keys
# GROQ_API_KEY=
# OpenRouter free models (50 requests/day): https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Cloudflare Workers AI (10,000 neurons/day)
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# Mistral "Experiment" plan
# MISTRAL_API_KEY=
# Azure OpenAI from Azure for Students credit
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Local models via Ollama (optional)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# ---------- Email (optional; in-app notifications always work) ----------
# EMAIL_FROM="LearnSphere Nexus <no-reply@yourdomain.example>"
# Brevo HTTP API (300/day free): https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=
# Resend HTTP API (needs a verified domain)
# RESEND_API_KEY=
# Any SMTP server (Gmail app password, Mailjet, Brevo SMTP) or local Mailpit (docker compose up mailpit)
# SMTP_HOST=localhost
# SMTP_PORT=1026
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ---------- Code execution ----------
# JavaScript/TypeScript and SQL always run in built-in WebAssembly sandboxes.
# Other languages use Docker when available ("auto"), or Judge0.
# CODE_EXEC_DOCKER=auto
# Self-hosted Judge0 CE
# JUDGE0_URL=http://localhost:2358
# Or Judge0 CE on RapidAPI (free Basic plan)
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# JUDGE0_KEY=

# ---------- Job feeds ----------
# Public job APIs synced a few times a day with attribution (set to "false" to disable)
# JOB_FEEDS=jobicy,himalayas,remotive
# JOB_FEED_SYNC=true

# Run the background worker in this process (set false only if you run a separate worker)
# WORKER_ENABLED=true

# ---------- Payments (optional; without keys the app runs in labelled demonstration mode) ----------
# Razorpay Payment Links (test keys are free: dashboard.razorpay.com, Test Mode)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Stripe Checkout (test keys are free: dashboard.stripe.com)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_CURRENCY=INR

# ---------- Calendar sync (optional; the private ICS subscription link works without these) ----------
# Google Calendar (OAuth client, consent screen in Testing mode)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Outlook (Entra app registration)
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# MS_OAUTH_TENANT=common
